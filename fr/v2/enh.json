,"masculine_plural":"enharmoniques"},[],["Intervalle enharmonique.","La musique des psaumes chantés ici appartient aux trois genres de la musique byzantine : diatonique, enharmonique et chromatique.","Ces transitions enharmoniques se répètent à satiété, et l'abus de la cadence plagale lui ôte une grande partie de sa solennité religieuse."]],[55209,"enharmoniquement","adverb",0,"","","",[["enharmonically","",[],[],[]]],{},[],""],[55210,"enharnacher","verb",0,"/ɑ̃.aʁ.na.ʃe/","",[39951,"LL-Q150_%28fra%29-LoquaxFR-enharnacher.wav.mp3"],[["to harness a horse","",[],[],[]],["to caparison","",[],[],[]]],{"infinitive":"enharnacher","auxiliary":"avoir","present_participle":"enharnachant","past_participle":"enharnaché","present":["enharnache","enharnaches","enharnache","enharnachons","enharnachez","enharnachent"],"imperfect":["enharnachais","enharnachais","enharnachait","enharnachions","enharnachiez","enharnachaient"],"future":["enharnacherai","enharnacheras","enharnachera","enharnacherons","enharnacherez","enharnacheront"],"conditional":["enharnacherais","enharnacherais","enharnacherait","enharnacherions","enharnacheriez","enharnacheraient"],"subjunctive":["enharnache","enharnaches","enharnache","enharnachions","enharnachiez","enharnachent"]},[],["Enharnacher un cheval.","Vous voilà bien enharnaché, plaisamment enharnaché.","Prenez le cheval de mon écurie le plus beau et le plus richement enharnaché."]],[55211,"enherber","verb",0,"/ɑ̃.nɛʁ.be/","",[39952,"LL-Q150_%28fra%29-Lyoko%C3%AF-enherber.wav.mp3"],[["to cover with grass","",["rare"],[],[]],["to poison","",[],["empoisonner"],[]]],{"infinitive":"enherber","auxiliary":"avoir","present_participle":"enherbant","past_participle":"enherbé","present":["enherbe","enherbes","enherbe","enherbons","enherbez","enherbent"],"imperfect":["enherbais","enherbais","enherbait","enherbions","enherbiez","enherbaient"],"future":["enherberai","enherberas","enherbera","enherberons","enherberez","enherberont"],"conditional":["enherberais","enher
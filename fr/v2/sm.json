{"entries":[[7878,"smoking","noun",3,"/smɔ.kiŋ/","m","",[["tuxedo, dinner jacket","",[],[],[["Varichkine avait endossé un smoking que nul dandy londonien n'eût renié, un smoking à revers de moire, avec un gilet de faille noire, orné d'une chaîne de montre à breloque symbolique : la faucille et le marteau d'or semés de rubis.","Varishkin had donned a tuxedo that no London dandy would have refused, a tuxedo with moire lapels, with a black faille waistcoat, adorned with a watch chain with a symbolic charm: the sickle and hammer, made of gold strewn with rubies.",""]]]],{"plural":"smokings"},[],""],[22918,"smala","noun",1,"/sma.la/","f","",[["tribe, entourage (of chieftain)","",[],[],[]],["entourage, posse, extended family","",["slang"],[],[["Il est venu avec toute la smala.","He came with his whole posse.",""]]]],{"plural":"smalas"},[],""],[23130,"smiley","noun",1,"/smaj.lɛ/","m",[18640,"LL-Q150_%28fra%29-LoquaxFR-smiley.wav.mp3"],[["smiley (logo of smiling face)","",[],[],[]]],{"plural":"smileys"},[],["Il n'aimait pas du tout quand je mettais un smiley qui faisait la tête."]],[24643,"smash","noun",1,"/smaʃ/","m",[19903,"LL-Q150_%28fra%29-Xenoph%C3%B4n-smash.wav.mp3"],[["smash","",[],[],[]]],{"plural":"smashs"},[],["Au fond le smash semble être l'incarnation de l'attaque, comme si toute attaque devait être un smash."]],[26765,"smasher","verb",1,"/sma.ʃe/","",[21670,"LL-Q150_%28fra%29-Lyoko%C3%AF-smasher.wav.mp3"],[["to smash","",[],[],[]]],{"infinitive":"smasher","auxiliary":"avoir","present_participle":"smashant","past_participle":"smashé","present":["smashe","smashes","smashe","smashons","smashez","smashent"],"imperfect":["smashais","smashais","smashait","smashions","smashiez","smashaient"],"future":["smasherai","smasheras","smashera","smasherons","smasherez","smasheront"],"conditional":["smasherais","smasherais","smasherait","smasherions","smasheriez","smasheraient"],"subjunctive":["smashe","smashes","smashe","smashions","smashiez","smashent"]},[],""],[27270,"smog",
{"entries":[[3357,"cahier","noun",4,"/ka.je/","m",[2803,"Fr-cahier.ogg.mp3"],[["notebook, exercise book","دفتر، دفتر مشق",[],[],[]],["quire","دستهٔ کاغذ",[],[],[]]],{"plural":"cahiers"},["cahier de textes","cahier des charges"],["Cahier de brouillon.","Cahier de papier réglé."],""],[11634,"cahoter","verb",2,"/ka.ɔ.te/","",[9620,"LL-Q150_%28fra%29-LoquaxFR-cahoter.wav.mp3"],[["to bump, jolt","تکان خوردن، ضربه خوردن",["transitive"],[],[]],["to jolt along, bounce along","با تکان و لرزش پیش رفتن",["intransitive"],[],[]]],{"infinitive":"cahoter","auxiliary":"avoir","present_participle":"cahotant","past_participle":"cahoté","present":["cahote","cahotes","cahote","cahotons","cahotez","cahotent"],"imperfect":["cahotais","cahotais","cahotait","cahotions","cahotiez","cahotaient"],"future":["cahoterai","cahoteras","cahotera","cahoterons","cahoterez","cahoteront"],"conditional":["cahoterais","cahoterais","cahoterait","cahoterions","cahoteriez","cahoteraient"],"subjunctive":["cahote","cahotes","cahote","cahotions","cahotiez","cahotent"]},[],["Il fut longtemps cahoté par la fortune.","Un chariot passait au loin près de la falaise ; on l'entendait cahoter et crier sur le pavé gelé.","Mais où sont les funérailles d'antan ? Les petits corbillards, corbillards, corbillards, corbillards de nos grands-pères Qui suivaient la route en cahotant."],"",[["cahot","noun"],["cahotant","adjective"],["cahotement","noun"],["cahoteux","adjective"],["cahoter","verb"]]],[11801,"cahot","noun",2,"/ka.o/","m",[9736,"LL-Q150_%28fra%29-LoquaxFR-cahot.wav.mp3"],[["jolt, bump","تکان، ضربه",[],[],[["Alors il cinglait de plus belle ses deux rosses tout en sueur, mais sans prendre garde aux cahots, accrochant par-ci par- là, ne s'en souciant, démoralisé, et presque pleurant de soif, de fatigue et de tristesse.","",""]]]],{"plural":"cahots"},[],"","",[["cahoter","verb"],["cahoteux","adjective"],["cahotant","adjective"],["cahotement","noun"],["cahot","noun"]]],[17557,"cahute","noun",2,"/ka.yt/","f",[14074,"LL-Q150_%28fra%29-Poslovitch-cahute.wav.mp3"],[["shack, hut","کلبه، آلونک",[],[],[]]],{"plural":"cahutes"},[],["Malgré sa maison au village, il s'est généralement installé une baraque, une cahute à l'abri du vent et c'est là qu'il passe le plus clair de son temps.","Son chemin l'a pourtant menée loin des sentiers battus, jusqu'à ce village du Tamil Nadu, entre Chennai et Pondichéry, dans cette cahute où elle est allongée."],""],[21152,"cahin-caha","adverb",2,"/ka.ɛ̃.ka.a/","",[17001,"LL-Q150_%28fra%29-Ltrlg-cahin-caha.wav.mp3"],[["hobbling along","لنگ‌لنگان پیش رفتن",[],[],[]]],{},[],["Hurlant, beuglant, glapissant, tous clopin-clopant, cahin-caha, se ruant vers la lumière, et vautrés dans la fange comme des limaces après la pluie.","Rien n'est triste dans un duel comme une guimbarde qui s'avance cahin-caha : il ne faut pas arriver en casse-cou, mais il ne faut pas arriver en invalide."],""],[21153,"cahotant","adjective",2,"","","",[["jolting","تکان‌تکان‌خور",[],[],[]]],{"masculine":"cahotant","feminine":"cahotante","masculine_plural":"cahotants","feminine_plural":"cahotantes"},[],["Une voiture cahotante est une voiture que la moindre inégalité de terrain fait cahoter."],"",[["cahoter","verb"],["cahot","noun"],["cahotement","noun"],["cahotant","adjective"]]],[22296,"cahoteux","adjective",1,"/ka.ɔ.tø/","",[17951,"LL-Q150_%28fra%29-Lyoko%C3%AF-cahoteux.wav.mp3"],[["bumpy; jolty","دست‌اندازدار، ناهموار",[],[],[]]],{"masculine":"cahoteux","feminine":"cahoteuse","masculine_plural":"cahoteux","feminine_plural":"cahoteuses"},[],["Une route cahoteuse.","À Chartres, un fiacre cahoteux, un tape-cul invraisemblable, nous conduisit au champ d'aviation.","« Le Parisien » (4/9) revient sur l'aventure cahoteuse des scooters Peugeot, dont le dernier-né s'est encore planté."],"",[["cahot","noun"],["cahoter","verb"],["cahoteux","adjective"]]],[28619,"cahotement","noun",1,"/ka.ɔt.mɑ̃/","m",[23160,"LL-Q150_%28fra%29-LoquaxFR-cahotement.wav.mp3"],[["jerk; jolt","تکان، ضربهٔ ناگهانی",[],[],[
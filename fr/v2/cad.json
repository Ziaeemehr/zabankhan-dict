lley.",""]]]],{"plural":"caddies"},[],"",""],[16774,"cadenasser","verb",2,"/kad.na.se/","",[13430,"LL-Q150_%28fra%29-LoquaxFR-cadenasser.wav.mp3"],[["to padlock","قفل آویز زدن",["transitive"],[],[]]],{"infinitive":"cadenasser","auxiliary":"avoir","present_participle":"cadenassant","past_participle":"cadenassé","present":["cadenasse","cadenasses","cadenasse","cadenassons","cadenassez","cadenassent"],"imperfect":["cadenassais","cadenassais","cadenassait","cadenassions","cadenassiez","cadenassaient"],"future":["cadenasserai","cadenasseras","cadenassera","cadenasserons","cadenasserez","cadenasseront"],"conditional":["cadenasserais","cadenasserais","cadenasserait","cadenasserions","cadenasseriez","cadenasseraient"],"subjunctive":["cadenasse","cadenasses","cadenasse","cadenassions","cadenassiez","cadenassent"]},[],["Il construisait des escaliers de secours et les cadenassait.","Plassans, quand il s'était bien cadenassé, se disait : « Je suis chez moi ».","Si la douleur cadenasse sur soi, elle immerge aussi dans l'abîme du présent."],"",[["cadenas","noun"],["cadenasser","verb"]]],[17077,"cadencé","adjective",2,"","","",[["rhythmic","ریتمیک، آهنگین",[],[],[]]],{"masculine":"cadencé","feminine":"cadencée","masculine_plural":"cadencés","feminine_plural":"cadencées"},[],["Mouvements cadencés.","Prose nombreuse et bien cadencée.","Une voix monta, cadencée, accompagnée d'un cliquetis de bracelets…"],"",[["cadencer","verb"],["cadencé","adjective"]]],[18533,"cadastral","adjective",2,"","","",[["cadastral","ثبتی، مربوط به کاداستر",[],[],[]]],{"masculine":"cadastral","feminine":"cadastrale","masculine_plural":"cadastraux","feminine_plural":"cadastrales"},[],["Les opérations cadastrales ont été commencées dans le département du Rhône en 1808, et ont été terminées en 1830."],"",[["cadastre","noun"],["cadastral","adjective"]]],[18625,"cadencer","verb",2,"/ka.dɑ̃.se/","",[14915,"LL-Q150_%28fra%29-Lyoko%C3%AF-cadencer.wav.mp3"],[["to cadence","آهنگ‌دار کردن، ضرب‌آهنگ دادن",["transitive"]
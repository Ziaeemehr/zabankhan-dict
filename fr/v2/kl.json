{"entries":[[7082,"klaxon","noun",3,"/klak.sɔn/","m",[5975,"LL-Q150_%28fra%29-Pamputt-klaxon.wav.mp3"],[["horn (of car)","",[],[],[]]],{"plural":"klaxons"},[],["Le klaxon d'une automobile fit sursauter le vieillard.","Dix ou vingt mille cornes, klaxons et trompes proclament éperdument la mobilisation du plaisir.","Et il fit pouët-pouët avec un klaxon en se tapant les cuisses de rire. Les deux agents secrets se regardèrent avec circonspection."]],[8901,"klaxonner","verb",3,"/klak.sɔ.ne/","",[7458,"LL-Q150_%28fra%29-Lyoko%C3%AF-klaxonner.wav.mp3"],[["to honk (sound a horn)","",[],[],[]]],{"infinitive":"klaxonner","auxiliary":"avoir","present_participle":"klaxonnant","past_participle":"klaxonné","present":["klaxonne","klaxonnes","klaxonne","klaxonnons","klaxonnez","klaxonnent"],"imperfect":["klaxonnais","klaxonnais","klaxonnait","klaxonnions","klaxonniez","klaxonnaient"],"future":["klaxonnerai","klaxonneras","klaxonnera","klaxonnerons","klaxonnerez","klaxonneront"],"conditional":["klaxonnerais","klaxonnerais","klaxonnerait","klaxonnerions","klaxonneriez","klaxonneraient"],"subjunctive":["klaxonne","klaxonnes","klaxonne","klaxonnions","klaxonniez","klaxonnent"]},[],["Aimez-vous le fromage qui klaxonne sur la table ?","Le camion vient de klaxonner, là-bas, au milieu de la patte-d'oie où il s'est arrêté pour nous attendre.","Il s'escrime à créer l'ambiance. « Allez, faites un max de bruit, allumez vos moteurs, klaxonnez ! » Bonnes pâtes, les gars se prêtent au jeu."]],[12091,"Kleenex","noun",2,"/kli.nɛks/","m","",[["Kleenex","",[],["mouchoir"],[]]],{},[],""],[30957,"kleptomane","noun",1,"/klɛp.tɔ.man/","","",[["kleptomaniac","",[],[],[]]],{"plural":"kleptomanes"},[],""],[32502,"klystron","noun",1,"/klis.tʁɔ̃/","m",[26262,"LL-Q150_%28fra%29-LoquaxFR-klystron.wav.mp3"],[["klystron","",[],[],[]]],{"plural":"klystrons"},[],["Voici, par exemple, quel est le principe des klystrons."]],[36182,"kleptomanie","noun",1,"/klɛp.tɔ.ma.ni/","f",[29099,"LL-Q150_%28fra%29-WikiLucas00-klep
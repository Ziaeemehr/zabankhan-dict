{"entries":[[4787,"inonder","verb",4,"/i.nɔ̃.de/","",[4055,"Fr-inonder.ogg.mp3"],[["to flood (to overflow)","",[],[],[]],["to inundate","",[],[],[]]],{"infinitive":"inonder","auxiliary":"avoir","present_participle":"inondant","past_participle":"inondé","present":["inonde","inondes","inonde","inondons","inondez","inondent"],"imperfect":["inondais","inondais","inondait","inondions","inondiez","inondaient"],"future":["inonderai","inonderas","inondera","inonderons","inonderez","inonderont"],"conditional":["inonderais","inonderais","inonderait","inonderions","inonderiez","inonderaient"],"subjunctive":["inonde","inondes","inonde","inondions","inondiez","inondent"]},[],["Le bébé inonde sa couche.","Le soleil inonde le salon.","Les pleurs inondaient son visage."]],[5286,"inouï","adjective",3,"/i.nwi/","",[4475,"LL-Q150_%28fra%29-DSwissK-inou%C3%AF.wav.mp3"],[["unheard","",[],[],[]],["unprecedented, incredible, unheard-of","",[],["exceptionnel","incroyable"],[["Bien que la faim et le dénûment nous tourmentassent quelquefois, et même à peu près toujours, rien ne nous causait autant de tourment que d'être témoins des cruautés inouïes que mon maître exerçait sur les chrétiens.","Even though hunger and destitution tormented us sometimes, and even almost always, nothing caused us as much torment as witnessing the unheard-of cruelties that my master inflicted upon the Christians.",""],["Voyage, voyage / Plus loin que la nuit et le jour (voyage, voyage) / Voyage (voyage) / Dans l'espace inouï de l'amour","Voyage, voyage / Further than the night and the day (voyage, voyage) / Voyage (voyage) / In the unheard-of space of love",""]]]],{"masculine":"inouï","feminine":"inouïe","masculine_plural":"inouïs","feminine_plural":"inouïes"},[],""],[5797,"inoffensif","adjective",3,"/i.nɔ.fɑ̃.sif/","",[4899,"LL-Q150_%28fra%29-Lepticed7-inoffensif.wav.mp3"],[["harmless","",[],[],[]]],{"masculine":"inoffensif","feminine":"inoffensive","masculine_plural":"inoffensifs","feminine_plural":"inoffensives
{"entries":[[733,"ombre","noun",5,"/ɔ̃bʁ/","f",[534,"Fr-ombre.ogg.mp3"],[["shade, shadow","",[],[],[]],["darkness","",[],[],[]],["ghost","",[],[],[]],["a fish of Osteichthyes of the freshwater family Salmonidae, of the genus Thymallus","",[],["corp","thymalle"],[]]],{"plural":"ombres"},["ombre à paupières"],["Les ombres de la nuit.","L'ombre même du mal lui fait peur.","Le soleil chasse, dissipe les ombres."]],[6402,"omelette","noun",3,"/ɔm.lɛt/","f","",[["omelette","",[],[],[]]],{"plural":"omelettes"},["omelette norvégienne","omelette espagnole"],["On leur fera une omelette et on leur donnera du « boustringue » et puis il y a du faro de première qualité et cela les apaise.","Ils étaient assis tous deux devant la petite table ronde sur laquelle Joséphine posait une omelette au rhum entourée de flammes.","– Et maintenant que j'ai parlé, j'espère qu'on ne verra plus Antoine Toquelot faire omelette avec des œufs de rossignol à l'ormeau de la Bastidone."]],[7999,"omettre","verb",3,"/ɔ.mɛtʁ/","",[6731,"Fr-omettre.ogg.mp3"],[["to omit","",["transitive"],[],[]]],{"infinitive":"omettre","auxiliary":"avoir","present_participle":"omettant","past_participle":"omis","present":["omets","omets","omet","omettons","omettez","omettent"],"imperfect":["omettais","omettais","omettait","omettions","omettiez","omettaient"],"future":["omettrai","omettras","omettra","omettrons","omettrez","omettront"],"conditional":["omettrais","omettrais","omettrait","omettrions","omettriez","omettraient"],"subjunctive":["omette","omettes","omette","omettions","omettiez","omettent"]},[],""],[9742,"omoplate","noun",3,"/ɔ.mɔ.plat/","f",[8142,"Fr-omoplate.ogg.mp3"],[["shoulder blade, scapula","",[],[],[["Et pendant ce temps-là, divine candeur, je sens le regard de mon saint Sébastien […] toujours dans mon dos. Ça me chauffe délicieusement les omoplates mais plutôt crever que de me retourner, ça gâcherait le poème.","",""]]]],{"plural":"omoplates"},[],""],[10308,"ombrelle","noun",3,"/ɔ̃.bʁɛl/","f",[8591,"LL-Q150_%28fra%29-Poslovitch-ombrelle.wav.mp3"],[["parasol","",[],[],[["Elle était sur le seuil; elle alla chercher son ombrelle, elle l'ouvrit. L'ombrelle, de soie gorge de pigeon, que traversait le soleil, éclairait de reflets mobiles la peau blanche de sa figure.","",""]]],["umbrella (the main body of a jellyfish, excluding the tentacles)","",[],[],[]]],{"plural":"ombrelles"},[],""],[13761,"ombrageux","adjective",2,"/ɔ̃.bʁa.ʒø/","",[11204,"LL-Q150_%28fra%29-Lyoko%C3%AF-ombrageux.wav.mp3"],[["umbrageous","",[],[],[]],["skittish, shy","",[],[],[]]],{"masculine":"ombrageux","feminine":"ombrageuse","masculine_plural":"ombrageux","feminine_plural":"ombrageuses"},[],["C'est un homme fort ombrageux. Un esprit ombrageux.","Tel un cheval ombrageux à qui on oublie de mettre les œillères.","Ainsi l'avait-elle bien vite tourmenté par sa vanité un peu ombrageuse."]],[13931,"ombrage","noun",2,"/ɔ̃.bʁaʒ/","m",[11337,"Fr-ombrage.ogg.mp3"],[["shade","",[],[],[]],["umbrage, offence","",[],[],[]]],{"plural":"ombrages"},["porter ombrage","prendre ombrage"],["Donner de l'ombrage à quelqu'un.","Ces arbres donnent un ombrage agréable.","Il en a pris ombrage. — Tout lui fait ombrage. — Tout lui porte ombrage."]],[14158,"omission","noun",2,"/ɔ.mi.sjɔ̃/","f","",[["omission (act of omitting)","",[],["prétérition"],[]]],{"plural":"omissions"},["mensonge par omission"],["Mentir par omission.","Sauf erreur ou omission.","C'est une omission grave."]],[14336,"ombrer","verb",2,"/ɔ̃.bʁe/","",[11628,"LL-Q150_%28fra%29-Lyoko%C3%AF-ombrer.wav.mp3"],[["to shade (put into the shade)","",[],[],[]]],{"infinitive":"ombrer","auxiliary":"avoir","present_participle":"ombrant","past_participle":"ombré","present":["ombre","ombres","ombre","ombrons","ombrez","ombrent"],"imperfect":["ombrais","ombrais","ombrait","ombrions","ombriez","ombraient"],"future":["ombrerai","ombreras","ombrera","ombrerons","ombrerez","ombreront"],"conditional":["ombrerais","ombrerais","ombrerait","ombrerions","ombreriez","ombreraient"],"su
,"LL-Q150_%28fra%29-Lyoko%C3%AF-ennuager.wav.mp3"],[["to cloud over (become cloudy)","",[],[],[]]],{"infinitive":"ennuager","auxiliary":"avoir","present_participle":"ennuageant","past_participle":"ennuagé","present":["ennuage","ennuages","ennuage","ennuageons","ennuagez","ennuagent"],"imperfect":["ennuageais","ennuageais","ennuageait","ennuagions","ennuagiez","ennuageaient"],"future":["ennuagerai","ennuageras","ennuagera","ennuagerons","ennuagerez","ennuageront"],"conditional":["ennuagerais","ennuagerais","ennuagerait","ennuagerions","ennuageriez","ennuageraient"],"subjunctive":["ennuage","ennuages","ennuage","ennuagions","ennuagiez","ennuagent"]},[],["Certains arbres s'ennuageaient de fleurs ; d'autres ployaient sous les fruits.","Elle fume ; et la fumée de sa cigarette ennuage de bleu ses maigres exquises épaules.","Tant de joies n'allèrent pas sans des heures ennuagées d'un voile de tristesse et d'inquiétude."]],[32781,"enneigement","noun",1,"/ɑ̃.nɛʒ.mɑ̃/","m",[26487,"LL-Q150_%28fra%29-Lyoko%C3%AF-enneigement.wav.mp3"],[["snowfall","",[],[],[]],["snow cover","",[],[],[]]],{"plural":"enneigements"},[],["Il n'a pas assez neigé cette année, il fa falloir procéder à l'enneigement des pistes.","Il est préférable de consulter les bulletins d'enneigement des stations de ski avant le départ pour un séjour de ski."]],[34131,"ennoblissement","noun",1,"/ɑ̃.nɔ.blis.mɑ̃/","m",[27548,"LL-Q150_%28fra%29-Lyoko%C3%AF-ennoblissement.wav.mp3"],[["ennoblement","",[],[],[]]],{"plural":"ennoblissements"},[],["Elle allait, cette lassitude, presque jusqu'à la tristesse, et la tristesse est un ennoblissement."]],[55229,"enne","noun",0,"/ɛn/","m","",[["The name of the Latin script letter N/n.","",[],[],[]]],{"plural":"ennes"},[],["Н̄ est composée d'un enne avec un macron."]],[55230,"ennemi du peuple","noun",0,"/ɛn.mi dy pœpl/","m","",[["enemy of the people","",[],[],[]]],{"plural":"ennemis du peuple","feminine":"ennemie du peuple"},[],""],[55231,"ennemi juré","noun",0,"/ɛn.mi ʒy.ʁe/","m",
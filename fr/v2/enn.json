{"entries":[[950,"ennemi","adjective",5,"/ɛn.mi/","",[707,"Fr-ennemi.ogg.mp3"],[["enemy","",[],[],[["feu ennemi","enemy fire",""]]]],{"masculine":"ennemi","feminine":"ennemie","masculine_plural":"ennemis","feminine_plural":"ennemies"},["ennemi juré","ennemi du peuple","frapper un ennemi à terre"],""],[951,"ennemi","noun",5,"/ɛn.mi/","m",[707,"Fr-ennemi.ogg.mp3"],[["enemy","",[],[],[["ennemi juré","archenemy",""],["frapper un ennemi à terre","to kick someone when they are down",""]]]],{"plural":"ennemis","feminine":"ennemie"},["ennemi juré","ennemi du peuple","frapper un ennemi à terre"],""],[1350,"ennui","noun",5,"/ɑ̃.nɥi/","m",[1046,"Fr-ennui.ogg.mp3"],[["boredom; lassitude","",["uncountable"],[],[["Notre ennui, nos mœurs fades sont le résultat du système politique.","Our boredom, our insipid customs, are the result of the political system.",""]]],["trouble, issue, annoyance","",[],[],[["— Mon Dieu ! nous étions d'une inquiétude ! dit le père qui avait suivi son fils, malgré le vent. Qu'est-il donc arrivé ? — Oh ! des ennuis tout le temps, expliqua-t-elle. D'abord, les chemins sont si mauvais, qu'il a fallu près de deux heures pour venir de Bayeux. Puis, à Arromanches, voilà qu'un cheval de Malivoire se casse une patte ; et il n'a pu nous en donner un autre, j'ai vu le moment qu'il nous faudrait coucher chez lui… Enfin, le docteur a eu l'obligeance de nous prêter son cabriolet. Ce brave Martin nous a conduites…","\"We have been very anxious about you,\" said the father, who had followed his son, in spite of the wind. \"What has happened to make you so late ?\" \" Oh ! we've had nothing but troubles,\" she answered. \"To begin with, the roads are so bad that it has taken us nearly two hours to come from Bayeux. Then, at Arromanches, one of Malivoire's horses went lame and he couldn't let us have another. At one time I really thought we should have to stay with him all night. But the Doctor was kind enough to offer us his gig, and Martin here has driven us home.\"",""]]]],{"plural":"ennuis"},[],""],[1454,"ennuyer","verb",5,"/ɑ̃.nɥi.je/","",[1137,"Fr-ennuyer.ogg.mp3"],[["to afflict with boredom; to bore","",[],[],[["J'espère que je ne vous ai pas ennuyé.","I hope I haven't bored you.",""]]],["to be bored","",["pronominal"],[],[]],["to miss something or someone","",[],[],[]],["to annoy, bother, trouble","",[],[],[]],["to worry","",[],[],[]]],{"infinitive":"ennuyer","auxiliary":"avoir","present_participle":"ennuyant","past_participle":"ennuyé","present":["ennuie","ennuies","ennuie","ennuyons","ennuyez","ennuient"],"imperfect":["ennuyais","ennuyais","ennuyait","ennuyions","ennuyiez","ennuyaient"],"future":["ennuierai","ennuieras","ennuiera","ennuierons","ennuierez","ennuieront"],"conditional":["ennuierais","ennuierais","ennuierait","ennuierions","ennuieriez","ennuieraient"],"subjunctive":["ennuie","ennuies","ennuie","ennuyions","ennuyiez","ennuient"]},[],""],[3661,"ennuyeux","adjective",4,"/ɑ̃.nɥi.jø/","",[3067,"Fr-ennuyeux.ogg.mp3"],[["dull, boring, tedious, tiresome, monotonous","",[],[],[]],["annoying","",[],[],[]]],{"masculine":"ennuyeux","feminine":"ennuyeuse","masculine_plural":"ennuyeux","feminine_plural":"ennuyeuses"},["ennuyeux comme la pluie"],["J'ai un problème ennuyeux.","Les garçons revenus du service militaire ont trouvé de plus en plus ennuyeuses les soirées du Causse enténébré et silencieux."]],[11340,"ennuyé","adjective",2,"/ɑ̃.nɥi.je/","","",[["annoyed, upset, sorry, angry, disappointed, embarrassed, concerned","",[],[],[]],["worried, bothered, annoyed (avoir l'air ennuyé)","",[],[],[]],["bored, ennuyé","",["rare"],[],[]]],{"masculine":"ennuyé","feminine":"ennuyée","masculine_plural":"ennuyés","feminine_plural":"ennuyées"},[],""],[14215,"enneigé","adjective",2,"/ɑ̃.nɛ.ʒe/","","",[["snowy, snow-covered","",[],[],[["une montagne enneigée","a snow-capped mountain",""]]]],{"masculine":"enneigé","feminine":"enneigée","masculine_plural":"enneigés","feminine_plural":"enneigées"},[],""],[17802,"enneiger","verb",2,"/ɑ̃.nɛ.
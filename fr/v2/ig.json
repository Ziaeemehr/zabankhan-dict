{"entries":[[758,"ignorer","verb",5,"/i.ɲɔ.ʁe/","",[553,"Fr-ignorer.ogg.mp3"],[["to ignore","",[],[],[]],["to be unaware of, to be ignorant of","",[],[],[]]],{"infinitive":"ignorer","auxiliary":"avoir","present_participle":"ignorant","past_participle":"ignoré","present":["ignore","ignores","ignore","ignorons","ignorez","ignorent"],"imperfect":["ignorais","ignorais","ignorait","ignorions","ignoriez","ignoraient"],"future":["ignorerai","ignoreras","ignorera","ignorerons","ignorerez","ignoreront"],"conditional":["ignorerais","ignorerais","ignorerait","ignorerions","ignoreriez","ignoreraient"],"subjunctive":["ignore","ignores","ignore","ignorions","ignoriez","ignorent"]},["ne pas être sans ignorer"],["Ce grand génie s'ignorait encore lui-même.","J'ignore l'art de flatter. Je préfère l'ignorer.","Après tout s'ils ne parlent pas de ce qu'ils ignorent est-ce blâmable."]],[4596,"ignorance","noun",4,"/i.ɲɔ.ʁɑ̃s/","f","",[["ignorance","",[],[],[["Tous les enfans ſont des athées; ils n'ont aucune idée de Dieu: ſont-ils donc criminels à cauſe de cette ignorance?","All children are born atheists; they have no idea of God. Are they then criminal on account of their ignorance?",""]]]],{"plural":"ignorances"},[],""],[4963,"ignoble","adjective",4,"/i.ɲɔbl/","","",[["ignoble, not noble","",[],[],[]],["disgusting, repulsive, horrible","",[],[],[]]],{"masculine":"ignoble","masculine_plural":"ignobles"},[],""],[7561,"ignorant","adjective",3,"/i.ɲɔ.ʁɑ̃/","",[6368,"Fr-ignorant.ogg.mp3"],[["ignorant","",[],[],[]]],{"masculine":"ignorant","feminine":"ignorante","masculine_plural":"ignorants","feminine_plural":"ignorantes"},[],["Il s'avoue ignorant.","Institutrice ignorante.","Tous ces peuples-là sont très ignorants."]],[11621,"ignominie","noun",2,"/i.ɲɔ.mi.ni/","f",[9610,"Fr-ignominie.ogg.mp3"],[["ignominy (great dishonor, shame, or humiliation)","",[],[],[]]],{"plural":"ignominies"},[],["Être couvert d'ignominie.","Tu t'es rassasié plus d'ignominie que de gloire.","La justesse de la cause 
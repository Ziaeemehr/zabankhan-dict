{"entries":[[1757,"usine","noun",4,"/y.zin/","f",[1403,"Fr-usine.ogg.mp3"],[["factory","",[],[],[]],["mill","",[],[],[]],["works","",[],[],[]]],{"plural":"usines"},["usine à gaz"],""],[2381,"usage","noun",4,"/y.zaʒ/","m",[1933,"Fr-usage.ogg.mp3"],[["usage, use","",[],[],[]],["the ways and contexts in which spoken and written words are actually used, determined by a lexicographer's intuition or from corpus analysis (as opposed to correct or proper use of language, proclaimed by some authority)","",[],[],[]]],{"plural":"usages"},["en usage","faire usage"],["L'usage de la parole.","J'ai mon usage dans tel bois.","A quel usage destinez-vous cela ?"]],[2493,"user","verb",4,"/y.ze/","",[2034,"Fr-user.ogg.mp3"],[["to wear, wear down, wear off, wear out, grind down, run in","",[],[],[["Trois kilomètres à pied, ça use les souliers.","Three kilometers on foot wears out the shoes.",""]]],["to use (used with de)","",[],[],[["Ne m'obligez pas à user de la force.","Don't make me use force.",""]]]],{"infinitive":"user","auxiliary":"avoir","present_participle":"usant","past_participle":"usé","present":["use","uses","use","usons","usez","usent"],"imperfect":["usais","usais","usait","usions","usiez","usaient"],"future":["userai","useras","usera","userons","userez","useront"],"conditional":["userais","userais","userait","userions","useriez","useraient"],"subjunctive":["use","uses","use","usions","usiez","usent"]},[],""],[5093,"usé","adjective",3,"/y.ze/","",[4311,"LL-Q150_%28fra%29-LoquaxFR-us%C3%A9.wav.mp3"],[["worn-out, deteriorated","",[],[],[]]],{"masculine":"usé","feminine":"usée","masculine_plural":"usés","feminine_plural":"usées"},["usé jusqu'à la corde"],["Une passion usée : Un amour refroidi, diminué par le temps.","Avoir le goût usé : Avoir le goût émoussé par le fréquent usage des mets trop épicés ou des liqueurs fortes."]],[6829,"usure","noun",3,"/y.zyʁ/","f","",[["usury","",["uncountable"],[],[["La cause première des stagnations commerciales et industrielles est donc l'intérêt des capitaux, cet intérêt que toute l'antiquité s'est accordée à flétrir sous le nom d'usure, lorsqu'il sert à payer le prix de l'argent, mais que l'on n'a jamais osé condamner sous les dénominations de loyer, fermage ou bénéfice : comme si l'espèce des choses prêtées pouvait jamais légitimer le prix du prêt, le vol.","The primary cause of commercial and industrial stagnations is, then, interest on capital, —that interest which the ancients with one accord branded with the name of usury, whenever it was paid for the use of money, but which they did not dare to condemn in the forms of house-rent, farmrent, or profit: as if the nature of the thing lent could ever warrant a charge for the lending; that is, robbery.",""]]],["wear and tear, wear","",["uncountable"],[],[]]],{"plural":"usures"},[],""],[7332,"us","noun",3,"/ys/","m",[6185,"LL-Q150_%28fra%29-Exilexi-us.wav.mp3"],[["mores; traditional practices or manners","",["plural-only"],[],[]]],{},["us et coutumes"],["C'est l'us. Il sait que Gaubert s'est avancé jusqu'à la placette de l''église et …","Mais, avant tout, la qualité de la coke dépend de l'us ou de l'abus qu'on en fait."]],[9592,"ustensile","noun",3,"/ys.tɑ̃.sil/","m",[8023,"Fr-ustensile.ogg.mp3"],[["utensil","",[],[],[["Seigneur barbier, ou qui que vous soyez, sachez que je suis du même état que vous ; […] et que je connais parfaitement tous les instruments et ustensiles du métier de la barbe, sans en excepter un seul[…].","Sir barber, or whoever you might be, know that I am of the same profession as you; […] and that I know perfectly all the instruments and utensils of the trade of barbering, without excepting a single one […] .",""]]]],{"plural":"ustensiles"},[],""],[11787,"usagé","adjective",2,"/y.za.ʒe/","",[9727,"LL-Q150_%28fra%29-WikiLucas00-usag%C3%A9.wav.mp3"],[["used","",[],[],[]],["worn","",[],[],[]],["second-hand","",[],[],[]]],{"masculine":"usagé","feminine":"usagée","masculine_plural":"usagés","feminine_plural":"usagées"},[],["Un vêtement, un livre usagé.","Des sacs neufs et des sacs usagés.","Une expression, une métaphore usagée."]],[13462,"usurier","adjective",2,"","","",[["acquisitive, avaricious","",[],[],[]]],{"masculine":"usurier","feminine":"usurière","masculine_plural":"usuriers","feminine_plural":"usurières"},[],""],[13463,"usurier","noun",2,"","m","",[["usurer, moneylender; loan shark","",[],[],[]]],{"plural":"usuriers","feminine":"usurière"},[],["On ne s'improvise pas usurier, il faut parvenir d'abord à une méritoire insertion dans la mafia des gens bien placés pour exploiter leur prochain.","Claude Riendeau, lui, est un ex-flic devenu voleur à main armée, usurier, trafiquant de coke et « détaillant » d'armes, comme il aime dire pudiquement."]],[14140,"usurper","verb",2,"/y.zyʁ.pe/","",[11488,"LL-Q150_%28fra%29-Lyoko%C3%AF-usurper.wav.mp3"],[["to usurp","",[],[],[]]],{"infinitive":"usurper","auxiliary":"avoir","present_participle":"usurpant","past_participle":"usurpé","present":["usurpe","usurpes","usurpe","usurpons","usurpez","usurpent"],"imperfect":["usurpais","usurpais","usurpait","usurpions","usurpiez","usurpaient"],"future":["usurperai","usurperas","usurpera","usurperons","usurperez","usurperont"],"conditional":["usurperais","usurperais","usurperait","usurperions","usurperiez","usurperaient"],"subjunctive":["usurpe","usurpes","usurpe","usurpions","usurpiez","usurpent"]},[],["Vous usurpez sur mes droits, sur mes possessions.","Ce cultivateur tâche toujours d'usurper sur ses voisins.","Que tout individu qui usurperait la souveraineté soit à l'instant mis à mort par les hommes libres."]],[16933,"usurpateur","adjective",2,"/y.zyʁ.pa.tœʁ/","","",[["usurping","",[],[],[]]],{"masculine":"usurpateur","feminine":"usurpatrice","masculine_plural":"usurpateurs","feminine_plural":"usurpatrices"},[],["Le peuple portait toute son attention sur le chevalier noir ; il remplissait l'air des cris de « Vive Richard Cœur-de-Lion ! À bas les templiers usurpateurs ! »"]],[16934,"usurpateur","noun",2,"/y.zyʁ.pa.tœʁ/","m","",[["usurper (one who usurps)","",[],[],[]]],{"plural":"usurpateurs","feminine":"usurpatrice"},[],["Le jeune roi des forêts, victime de Tord-Chêne, - son oncle, usurpateur, - savait déjà quel était son rang, qu'on voulait lui cacher."]],[17317,"usurpation","noun",2,"/y.zyʁ.pa.sjɔ̃/","f",[13871,"LL-Q150_%28fra%29-WikiLucas00-usurpation.wav.mp3"],[["usurpation (wrongful seizure)","",[],[],[]],["that which is usurped","",[],[],[]]],{"plural":"usurpations"},["usurpation d'identité"],["La plupart des terres de cette seigneurie n'étaient que des usurpations.","J'en appellerai à Rome contre toi, répondit le grand maître, pour usurpation sur les immunités et privilèges de notre ordre."]],[18575,"usager","noun",2,"/y.za.ʒe/","m",[14874,"Fr-un_usager.ogg.mp3"],[["user","",[],[],[]]],{"plural":"usagers","feminine":"usagère"},["usager faible"],["Déjà difficile à percer pour des raisons techniques – instabilité géologique et séismicité connue des autorités –, le tunnel de Bolu inquiète les usagers."]],[19247,"usuel","adjective",2,"/y.zɥɛl/","",[15417,"LL-Q150_%28fra%29-WikiLucas00-usuel.wav.mp3"],[["usual, everyday","",[],[],[]]],{"masculine":"usuel","feminine":"usuelle","masculine_plural":"usuels","feminine_plural":"usuelles"},[],["Ce rappel à la réalité quotidienne et aux occupations usuelles change momentanément le cours de mes pensées."]],[21681,"usiner","verb",2,"/y.zi.ne/","",[17439,"LL-Q150_%28fra%29-Lyoko%C3%AF-usiner.wav.mp3"],[["to machine","",["transitive"],[],[]],["to manufacture (using machinery)","",["transitive"],[],[]]],{"infinitive":"usiner","auxiliary":"avoir","present_participle":"usinant","past_participle":"usiné","present":["usine","usines","usine","usinons","usinez","usinent"],"imperfect":["usinais","usinais","usinait","usinions","usiniez","usinaient"],"future":["usinerai","usineras","usinera","usinerons","usinerez","usineront"],"conditional":["usinerais","usinerais","usinerait","usinerions","usineriez","usineraient"],"subjunctive":["usine","usines","usine","usinions","usiniez","usinent"]},[],["Usiner une pièce de métal.","La file d'attente dans laquelle je suis aboutit à deux caisses. À un moment, il convient de choisir entre les deux caissières qui usinent dos à dos."]],[24424,"usufruit","noun",1,"/y.zy.fʁɥi/","m",[19733,"LL-Q150_%28fra%29-Lyoko%C3%AF-usufruit.wav.mp3"],[["usufruct","",[],[],[]]],{"plural":"usufruits"},[],""],[25279,"usant","adjective",1,"/y.zɑ̃/","",[20434,"LL-Q150_%28fra%29-LoquaxFR-usant.wav.mp3"],[["tiring, tiresome, exhausting, taxing","",["informal"],["fatigant","épuisant"],[]]],{"masculine":"usant","feminine":"usante","masculine_plural":"usants","feminine_plural":"usantes"},[],["Fille usante de ses droits.","Daudet porte sa maladie avec dignité, certes, mais la souffrance est usante et elle fait ressortir la désillusion des bonheurs perdus."]],[28541,"usité","adjective",1,"/y.zi.te/","",[23104,"LL-Q150_%28fra%29-Lyoko%C3%AF-usit%C3%A9.wav.mp3"],[["in use; current; still used","",[],[],[]]],{"masculine":"usité","feminine":"usitée","masculine_plural":"usités","feminine_plural":"usitées"},[],["Ce mot n'est guère usité.","Une façon de parler fort usitée.","Cela est fort usité dans ce pays."]],[30600,"usuraire","adjective",1,"/y.zy.ʁɛʁ/","",[24746,"LL-Q150_%28fra%29-Lyoko%C3%AF-usuraire.wav.mp3"],[["usurious","",[],[],[]]],{"masculine":"usuraire","masculine_plural":"usuraires"},[],["Les serfs qui ne pouvaient payer les taxes exigées s'endettaient, souvent à des taux usuraires.","Il ne refusait jamais d'accéder aux demandes de petits prêts d'argent qu'il consentait à des taux point trop usuraires pour l'époque.","Aux entreprises, il demande d'autre part de ne pas réclamer de « compensations usuraires » liées à ces arrêts de chantier pour cas de force majeure."]],[32238,"usinier","adjective",1,"/y.zi.nje/","",[26062,"LL-Q150_%28fra%29-WikiLucas00-usinier.wav.mp3"],[["factory, plant","",[],[],[]]],{"masculine":"usinier","feminine":"usinière","masculine_plural":"usiniers","feminine_plu
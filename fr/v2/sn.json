],[16599,"snack","noun",2,"/snak/","m",[13288,"LL-Q150_%28fra%29-Beno%C3%AEt_Prieur-snack.wav.mp3"],[["snack bar","",[],["snack-bar"],[]]],{"plural":"snacks"},[],["Cornes de cerf et de snack.","Idée de bouchée , de mordre dans la nourriture, déverbatif de to snack","Il faut supprimer les sucres raffinés : plats ultratransformés, pâtisseries, snacks et pains industriels."]],[19789,"snober","verb",2,"/snɔ.be/","",[15858,"LL-Q150_%28fra%29-Lyoko%C3%AF-snober.wav.mp3"],[["to snub, high-hat, disregard someone","",["transitive"],[],[]],["to refuse, ignore, disdain a favor, an honor","",["transitive"],[],[]]],{"infinitive":"snober","auxiliary":"avoir","present_participle":"snobant","past_participle":"snobé","present":["snobe","snobes","snobe","snobons","snobez","snobent"],"imperfect":["snobais","snobais","snobait","snobions","snobiez","snobaient"],"future":["snoberai","snoberas","snobera","snoberons","snoberez","snoberont"],"conditional":["snoberais","snoberais","snoberait","snoberions","snoberiez","snoberaient"],"subjunctive":["snobe","snobes","snobe","snobions","snobiez","snobent"]},[],["Il m'a bien vue à cette soirée mais il m'a snobée.","Elle a snobé l'invitation que nous lui avions envoyée.","La maladie et la mort sont deux bourgeoises qu'il faut snober sans rougir."]],[22679,"snack-bar","noun",1,"/snak.baʁ/","m",[18271,"LL-Q150_%28fra%29-Beno%C3%AEt_Prieur-snack-bar.wav.mp3"],[["snack bar","",[],[],[]]],{"plural":"snack-bars"},[],["Ouvrir un snack-bar, être serveuse dans un snack-bar.","J'avais mangé mes premiers hamburgers, grilled-cheese, doughnuts et banana split au snack-bar du camp militaire où je travaillais. — (Le Devoir, 3 août 2006)","Il arrive les mains dans les poches, jean délavé et cigarette au bec, pour siroter une bière dans un modeste snack-bar de Washington DC, à deux pas du Capitole."]],[25347,"snobinard","adjective",1,"/snɔ.bi.naʁ/","",[20495,"LL-Q150_%28fra%29-LoquaxFR-snobinard.wav.mp3"],[["snobby, snobbish","",["derogatory"],[],[["Il m'énerve avec ses façons snobinardes et ses airs supérieurs.","He gets on my nerves with his stuck-up ways and his airs and graces.",""]]]],{"masculine":"snobinard","feminine":"snobinarde","masculine_plural":"snobinards","feminine_plural":"snobinardes"},[],""],[25348,"snobinard","noun",1,"/snɔ.bi.naʁ/","m",[20495,"LL-Q150_%28fra%29-LoquaxFR-snobinard.wav.mp3"],[["a snob","",["derogatory"],[],[["Elle toise tout le monde parce que papa maman sont pleins d'argent, une vraie snobinarde !","She looks down on everyone because Mummy and Daddy are loaded; what a snob!",""]]]],{"plural":"snobinards","feminine":"snobinarde"},[],""],[26042,"sniff","noun",1,"","m",[21083,"LL-Q150_%28fra%29-LoquaxFR-sniff.wav.mp3"],[["sniff","",[],[],[]]],{"plural":"sniffs"},[],["Après notre petite fête d'anniversaire — un sniff terrible pour moi et un bon shoot pour Detlev — on se met vraiment ensemble."]],[38744,"SNA","noun",0,"","m",[30490,"LL-Q150_%28fra%29-WikiLucas00-SNA.wav.mp3"],[["an SSN / SSKN / SSAN (nuclear-powered attack submarine); abbreviation of Sous-Marin Nucléaire d'Attaque","",[],[],[]]],{"plural":"SNAs"},[],""],[38745,"SNLE","noun",0,"","m",[30491,"LL-Q150_%28fra%29-WikiLucas00-SNLE.wav.mp3"],[["an SSBN (nuclear-powered ballistic missile submarine); abbreviation of Sous-Marin Nucléaire Lanceur d'Engins","",[],[],[]]],{},[],""],[79864,"snacker","verb",0,"","",[51625,"LL-Q150_%28fra%29-Bananax47-snacker.wav.mp3"],[["to cook rapidly in a very hot pan, or with a kitchen torch (often leaving the middle uncooked)","",[],[],[]]],{"infinitive":"snacker","auxiliary":"avoir","present_participle":"snackant","past_participle":"snacké","present":["snacke","snackes","snacke","snackons","snackez","snackent"],"imperfect":["snackais","snackais","snackait","snackions","snackiez","snackaient"],"future":["snackerai","snackeras","snackera","snackerons","snackerez","snackeront"],"conditional":["snackerais","snackerais","snackerait","snackerions","snackeriez","snackeraient"],"subjunctive":["snacke","snackes","snacke","snackions","snackiez","snackent"]},[],["Four à Snacker et Toast","Plaque à snacker plancha électrique comme neuve."]],[79865,"snobage","noun",0,"/snɔ.baʒ/","m","",[["snobbery, snobbishness; snubbing, the act of snubbing someone","",[],[],[["La progression de l'histoire économique serait sans doute plus rapide, d'ailleurs, si la discussion sur les critères, les méthodes et la problématique revêtait un caractère public et clairement dialectique au lieu de reposer sur des insinuations, des refus boudeurs ou, tout simplement, un snobage élitiste.","The progress of economic history would no doubt be more rapid, moreover, if the discussion of criteria, methods and problematics took on a public and clearly dialectical character instead of being based on insinuations, sulky refusals or, simply, an elitist snobbishness.",""],["La presse parisienne, qui la veille en faisait des gorges chaudes, déduisit de ce \"snobage\" qu'au fond ce qu'avait à dire ce jeune avocat inconnu en France ne devait pas valoir le déplacement, […].","The Parisian press, which had the day before made light of things, deduced from this \"snobbery\" that basically, what this young lawyer unknown in France had to say, wouldn't be worth the trip.",""]]]],{"plural":"snobages"},[],""],[79866,"snobissime","adjective",0,"/snɔ.bi.sim/","",[51626,"LL-Q150_%28fra%29-DenisdeShawi-snobissime.wav.mp3"],[["very snobbish","",[],[],[["Les snobissimes cadres supérieurs de la prestigieuse banque d'affaires, alors au bord du gouffre, toisaient leurs nouveaux propriétaires. (Lyonnais-Agricole, une union acrobatique)","",""]]]],{"masculine":"snobissime","masculine_plural":"snobissimes"},[],""],[79867,"snooker","noun",0,"/snu.kœʁ/","m",[51627,"LL-Q150_%28fra%29-Lyoko%C3%AF-snooker.wav.mp3"],[["snooker","",[],[],[]]],{"plural":"snookers"},[],["Le jour où Irina accepte de dîner seule avec Ramsey Acton, célèbre joueur de snooker, elle ne se doute pas que sa vie va basculer."]],[79868,"snow-boot","noun",0,"/sno.but/",
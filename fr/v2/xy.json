.mp3"],[["xylophage","",[],[],[]]],{"plural":"xylophages"},[],""],[85910,"xylophagie","noun",0,"","f","",[["xylophagy","",[],[],[]]],{"plural":"xylophagies"},[],""],[85911,"xylophène","noun",0,"/ɡzi.lɔ.fɛn/","m",[54250,"Fr-BE-BW--xyloph%C3%A8ne.ogg.mp3"],[["xylophene","",[],[],[]]],{"plural":"xylophènes"},[],""],[85912,"xylopie","noun",0,"","f","",[["xylopia","",[],[],[]]],{"plural":"xylopies"},[],["D'autres arbustes de la même famille donnent des produits similaires, comme l'habzeli et le zelim d'Ethiopie ou la xylopie sud-américaine.","Les principaux genres de cette famille sont les suivants : corossol, monodore, canang, habzéli, asiminier, porcélie, xylopie, guattérie, etc."]],[85913,"xylorimba","noun",0,"","m","",[["a xylorimba","",[],[],[]]],{"plural":"xylorimbas"},[],""],[85914,"xylostome","noun",0,"/ɡzi.lɔs.tɔm/","m",[54251,"LL-Q150_%28fra%29-LoquaxFR-xylostome.wav.mp3"],[["synonym of gueule de bois","",[],["gueule de bois"],[]]],{"plural":"xylostomes"},[],""],[85915,"xylothèque","noun",0,"/ɡzi.lɔ.tɛk/","f",[54252,"Fr-Paris--xyloth%C3%A8que.ogg.mp3"],[["xylotheque","",[],[],[]]],{"plural":"xylothèques"},[],""],[85916,"xyloïdine","noun",0,"","f","",[["xyloidin","",[],[],[]]],{"plural":"xyloïdines"},[],""],[85917,"xylème","noun",0,"/ɡzi.lɛm/","m",[54253,"LL-Q150_%28fra%29-Lyoko%C3%AF-xyl%C3%A8me.wav.mp3"],[["xylem","",[],[],[]]],{"plural":"xylèmes"},[],["Les composés azotés du xylème peuvent accessoirement être transférés vers le phloème par l'apoplaste.","Les acides aminés sont transportés dans les 2 systèmes vasculaires des plantes que sont xylème et phloème.","Le moteur de l'ascension de l'eau, pompée des racines vers les organes via les tubes du xylème, est l'évaporation qui se produit au niveau des feuilles."]],[85918,"xylénol","noun",0,"","m","",[["xylenol","",[],[],[]]],{"plural":"xylénols"},[],""],[85919,"xyste","noun",0,"/ɡzist/","m",[54254,"LL-Q150_%28fra%29-Lyoko%C3%AF-xyste.wav.mp3"],[["xyst; xystus","",[],[],[]]],{"plural":"xystes"},[],["Par derrière régnait un grand xyste circulaire pour les jeux de toute espèce.","La vie grecque se composait de quelques pièces essentielles (…) une éphébie, pour la jeunesse (…) un gymnase et un xyste pour les exercices du corps.","Un xyste ou lieu d'exercice tout parfumé de violettes est au devant de cette galerie, qui sert par sa réverbération à y augmenter l'ardeur du soleil."]]],"redirects":{"xylaloës":[[85882,2]],"xylharmonicons":[[85883,2]],"xylicoles":[[85884,3]],"xylidines":[[85885,3]],"xyliques":[[85886,2]],"xylochimies":[[85888,0]],"xylocryptites":[[85889,0]],"xylocultures":[[85890,0]],"xylodies":[[85891,0]],"xylofers":[[85892,2]],"xyloglossies":[[85893,0]],"xylographes":[[85894,2]],"xylographies":[[30415,3]],"xylographiques":[[85895,3]],"xylogènes":[[85896,2]],"xylolalies":[[85898,0]],"xylolithes":[[85899,0]],"xylologues":[[85901,1]],"xylols":[[85897,3]],"xylolâtres":[[85902,2]],"xylolâtries":[[85903,0]],"xylométries":[[85904,0]],"xylonides":[[85905,2]],"xylopales":[[85906,2]],"xylopentaxophiles":[[85907,1]],"xylophages":[[85908,3],[85909,2]],"xylophagies":[[85910,0]],"xylophones":[[24350,2]],"xylophonistes":[[35649,1]],"xylophènes":[[85911,2]],"xylopies":[[85912,0]],"xylorimbas":[[85913,2]],"xylostomes":[[85914,2]],"xylothèques":[[85915,0]],"xyloïdines":[[85916,0]],"xylèmes":[[85917,2]],"xylènes":[[36000,2]],"xylénols":[[85918,2]],"xystes":[[85919,2]]},"targets":{"24350":["xylophone","noun"],"30415":["xylographie","noun"],"35649":["xylophoniste","noun"],"36000":["xylène","noun"],"85882":["xylaloë","noun"],"85883":["xylharmonicon","noun"],"85884":["xylicole","adjective"],"85885":["xylidine","noun"],"85886":["xylique","adjective"],"85888":["xylochimie","noun"],"85889":["xylocryptite","noun"],"85890":["xyloculture","noun"],"85891":["xylodie","noun"],"85892":["xylofer","noun"],"85893":["xyloglossie","noun"],"85894":["xylographe","noun"],"85895":["xylographique","adjective"],"85896":["xylogène","noun"],"85897":["xylol","noun"],"85898":["xylolalie","noun"],"85899":["xyl
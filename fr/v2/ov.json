],[]]],{"plural":"ovariotomies"},[],""],[36248,"ovipare","adjective",1,"/ɔ.vi.paʁ/","",[29147,"LL-Q150_%28fra%29-0x010C-ovipare.wav.mp3"],[["oviparous, egglaying","",[],[],[]]],{"masculine":"ovipare","masculine_plural":"ovipares"},[],["La poule est un animal ovipare.","La plupart des poissons sont ovipares."]],[37187,"ovariectomie","noun",1,"/ɔ.va.ʁjɛk.tɔ.mi/","f",[29832,"LL-Q150_%28fra%29-LoquaxFR-ovariectomie.wav.mp3"],[["ovariectomy","",[],[],[]]],{"plural":"ovariectomies"},[],""],[37188,"ovin","adjective",1,"/ɔ.vɛ̃/","",[29833,"LL-Q150_%28fra%29-WikiLucas00-ovin.wav.mp3"],[["sheep; ovine","",[],[],[]]],{"masculine":"ovin","feminine":"ovine","masculine_plural":"ovins","feminine_plural":"ovines"},[],""],[37189,"ovin","noun",1,"/ɔ.vɛ̃/","m",[29833,"LL-Q150_%28fra%29-WikiLucas00-ovin.wav.mp3"],[["ovine (a sheep)","",[],[],[]]],{"plural":"ovins"},[],["Ce mal se rencontre surtout chez les jeunes ovins de la première et de la deuxième année; la bête est sans entrain.","Un agneau, ce n'est pas un mouton, et, si c'est un ovin, un animal, ce n'est pas n'importe quel ovin, n'importe quel animal."]],[37190,"ovulaire","adjective",1,"","","",[["ovular","",[],[],[]]],{"masculine":"ovulaire","masculine_plural":"ovulaires"},[],""],[70008,"ovalbumine","noun",0,"/ɔ.val.by.min/","f",[47038,"LL-Q150_%28fra%29-Bananax47-ovalbumine.wav.mp3"],[["ovalbumin","",[],[],[]]],{"plural":"ovalbumines"},[],["Pour la fièvre jaune, s'assurer aussi de la teneur en ovalbumine."]],[70009,"ovalisation","noun",0,"/ɔ.va.li.za.sjɔ̃/","f",[47039,"LL-Q150_%28fra%29-Bananax47-ovalisation.wav.mp3"],[["ovalization","",[],[],[]]],{"plural":"ovalisations"},[],["Autant que faire se peut, on évite cette dernière disposition qui amène promptement l'ovalisation des cylindres et des pistons.","En revanche, si un même pneu présente deux plats sur les deux côtés opposés, cela peut provenir d'une ovalisation du tambour de frein.","Ce qui semble avoir poussé Rotor à produire ces plateaux avec une ovalisation accrue, c'est l'effet de mode et la demande de certains coureurs professionnels."]],[70010,"ovaliser","verb",0,"/ɔ.va.li.ze/","",[47040,"LL-Q150_%28fra%29-Lyoko%C3%AF-ovaliser.wav.mp3"],[["to ovalize","",[],[],[]]],{"infinitive":"ovaliser","auxiliary":"avoir","present_participle":"ovalisant","past_participle":"ovalisé","present":["ovalise","ovalises","ovalise","ovalisons","ovalisez","ovalisent"],"imperfect":["ovalisais","ovalisais","ovalisait","ovalisions","ovalisiez","ovalisaient"],"future":["ovaliserai","ovaliseras","ovalisera","ovaliserons","ovaliserez","ovaliseront"],"conditional":["ovaliserais","ovaliserais","ovaliserait","ovaliserions","ovaliseriez","ovaliseraient"],"subjunctive":["ovalise","ovalises","ovalise","ovalisions","ovalisiez","ovalisent"]},[],["Sur un visage rond, la barbe en pointe affinera le visage, à l'inverse, une barbe courte permettra d'ovaliser un visage long.","Les manchons sont généralement livrés pré-pliés. Veiller à les ovaliser manuellement afin de faciliter le passage du plant forestier."]],[70011,"ovalène","noun",0,"","m","",[["ovalene","",[],[],[]]],{"plural":"ovalènes"},[],""],[70012,"ovarite","noun",0,"/ɔ.va.ʁit/","f",[47041,"LL-Q150_%28fra%29-WikiLucas00-ovarite.wav.mp3"],[["ovaritis","",[],[],[]]],{"plural":"ovarites"},[],["Les termes d'oophorite, d'oophorectomie et de oophoralgie sont synonymes d'ovarite, d'ovariectomie et d'ovarialgie."]],[70013,"overbooker","verb",0,"/ɔ.vœʁ.bu.ke/","",[47042,"LL-Q150_%28fra%29-Lyoko%C3%AF-overbooker.wav.mp3"],[["to overbook","",[],["surbooker"],[]]],{"infinitive":"overbooker","auxiliary":"avoir","present_participle":"overbookant","past_participle":"overbooké","present":["overbooke","overbookes","overbooke","overbookons","overbookez","overbookent"],"imperfect":["overbookais","overbookais","overbookait","overbookions","overbookiez","overbookaient"],"future":["overbookerai","overbookeras","overbookera","overbookerons","overbookerez","overbookeront"],"conditional":["overbookerais","overbookerais","overbookerait","overbookerions","overbookeriez","overbookeraient"],"subjunctive":["overbooke","overbookes","overbooke","overbookions","overbookiez","overbookent"]},[],""],[70014,"oviducte","noun",0,"/ɔ.vi.dykt/","m",[47043,"LL-Q150_%28fra%29-WikiLucas00-oviducte.wav.mp3"],[["oviduct, Fallopian tube","",[],["trompe de Fallope"],[]]],{"plural":"oviductes"},[],["L'albumine peut passer librement de l'oviducte ou du milieu de culture dans l'embryon."]],[70015,"oviforme","adjective",0,"/ɔ.vi.fɔʁm/","","",[["egg-shaped, oviform","",[],[],[]]],{"masculine":"oviforme","masculine_plural":"oviformes"},[],""],[70016,"oviparité","noun",0,"/ɔ.vi.pa.ʁi.te/","f",[47044,"LL-Q150_%28fra%29-Bananax47-oviparit%C3%A9.wav.mp3"],[["oviparity","",[],[],[]]],{"plural":"oviparités"},[],["Cependant, l'oviparité est particulièrement efficace et la plupart des espèces de reptiles et d'oiseaux utilisent ce mode de reproduction actuellement."]],[70017,"ovipositeur","noun",0,"/ɔ.vi.po.zi.tœʁ/","m",[47045,"LL-Q150_%28fra%29-Poslovitch-ovipositeur.wav.mp3"],[["ovipositor","",[],[],[]]],{"plural":"ovipositeurs"},[],["Certains parasitoïdes ont un ovipositeur très long pour fouiller dans les profondeurs du support où s'est enfoui leur hôte."]],[70018,"oviscapte","noun",0,"/ɔ.vis.kapt/","m",[47046,"LL-Q150_%28fra%29-Bananax47-oviscapte.wav.mp3"],[["ovipositor","",[],[],[]]],{"plural":"oviscaptes"},[],["Tandem du leste à forceps (Lestes forcipatus) : à l'aide de son oviscapte, la femelle, retenue par le mâle, insère un à un ses œufs dans le tissu végétal."]],[70019,"ovisme","noun",0,"/ɔ.vism/","m",[47047,"LL-Q150_%28fra%29-Lyoko%C3%AF-ovisme.wav.mp3"],[["ovism","",[],[],[]]],{"plural":"ovismes"},[],["L'ovisme n'en est pas moins prouvé, puisqu'on trouve des œufs en nombre égal à celui des corps jaunes qui les produisent.","Pour l'ovisme, l'embryon est préformé dans la femelle. Le sperme est inutile ou il apporte une aura seminalis, une essence vitale."]],[70020,"oviste","adjective",0,"/ɔ.vist/","",[47048,"LL-Q150_%28fra%29-Lyoko%C3%AF-oviste.wav.mp3"],[["ovist","",[],[],[]]],{"masculine":"oviste","masculine_plural":"ovistes"},[],""],[70021,"oviste","noun",0,"/ɔ.vist/","",[47048,"LL-Q150_%28fra%29-Lyoko%C3%AF-oviste.wav.mp3"],[["ovist","",[],[],[]]],{"plural":"ovistes"},[],""],[70022,"ovniologie","noun",0,"/ɔv.njɔ.lɔ.ʒi/","f",[47049,"LL-Q150_%28fra%29-Sagnamadr-ovniologie.wav.mp3"],[["ufology","",[],["ufologie"],[]]],{"plural":"ovniologies"},[],["Cette discipline, parfois appelée « ovniologie », consiste donc à étudier les ovnis."]],[70023,"ovniologue","noun",0,"/ɔv.njɔ.lɔɡ/","",[47050,"LL-Q150_%28fra%29-Lyoko%C3%AF-ovniologue.wav.mp3"],[["ufologist","",[],[],[]]],{"plural":"ovniologues"},[],""],[70024,"ovogenèse","noun",0,"/ɔ.vɔʒ.nɛz/","f",[47051,"LL-Q150_%28fra%29-DenisdeShawi-ovogen%C3%A8se.wav.mp3"],[["ovogenesis","",[],[],[]]],{"plural":"ovogenèses"},[],["L'ovogenèse est le processus de production des ovules qui débute dans l'ovaire et se termine dans la trompe de Fallope.","L'ovogenèse est l'ensemble des processus conduisant à la formation des gamètes femelles, les ovules ou plus improprement, « œufs vierges»."]],[70025,"ovogonie","noun",0,"/ɔ.vɔ.ɡɔ.ni/","f",[47052,"LL-Q150_%28fra%29-Lyoko%C3%AF-ovogonie.wav.mp3"],[["ovogonium, oogonium","",[],[],[]]],{"plural":"ovogonies"},[],["En retour, l'ovogonie envoie un signal de type Jagged activant la voie Notch dans la niche."]],[70026,"ovologie","noun",0,"/ɔ.vɔ.lɔ.ʒi/","f",[47053,"LL-Q150_%28fra%29-Bananax47-ovologie.wav.mp3"],[["ovology","",[],[],[]],["embryology","",[],["embryologie"],[]],["oology","",[],["oologie"],[]]],{"plural":"ovologies"},[],["Les deux règnes, qui sétaient confondus dans leurs origines, se rapprochent encore par leur ovologie."]],[70027,"ovotide","noun",0,"/ɔ.vɔ.tid/","m",[47054,"LL-Q150_%28fra%29-Bananax47-ovotide.wav.mp3"],[["ootid","",[],[],[]]],{"plural":"ovotides"},[],["Le noyau de l'ovotide se reconstitue, gonfle et devient le « pronucléus femelle »."]],[70028,"ovovitelline","noun",0,"","f","",[["
],[],[]]],{},[],["L'azote liquide est utilisé pour la cryoconservation. Ainsi, en insémination artificielle, la semence des mâles peut être conservée dans l'azote liquide."]],[44270,"azoteux","adjective",0,"/a.zɔ.tø/","",[33800,"LL-Q150_%28fra%29-LoquaxFR-azoteux.wav.mp3"],[["synonym of nitreux","",[],["nitreux"],[]]],{"masculine":"azoteux","feminine":"azoteuse","masculine_plural":"azoteux","feminine_plural":"azoteuses"},[],["À l'acide azoteux AzO₂H correspondent les azotites utilisés (sels de sodium, de potassium) dans l'industrie des matières colorantes."]],[44271,"azothydrique","adjective",0,"/a.zɔ.ti.dʁik/","",[33801,"LL-Q150_%28fra%29-LoquaxFR-azothydrique.wav.mp3"],[["hydrazoic","",[],[],[]]],{"masculine":"azothydrique","masculine_plural":"azothydriques"},[],["L'acide azothydrique est extrêmement dangereux, du fait de sa grande toxicité et de son pouvoir explosif."]],[44272,"azotien","adjective",0,"","","",[["of Azotus","",[],[],[]]],{"masculine":"azotien","feminine":"azotienne","masculine_plural":"azotiens","feminine_plural":"azotiennes"},[],""],[44273,"azotique","adjective",0,"/a.zɔ.tik/","",[33802,"LL-Q150_%28fra%29-LoquaxFR-azotique.wav.mp3"],[["azotic","",[],[],[]],["nitric","",[],[],[]]],{"masculine":"azotique","masculine_plural":"azotiques"},["acide azotique"],""],[44274,"azotite","noun",0,"/a.zɔ.tit/","m",[33803,"LL-Q150_%28fra%29-LoquaxFR-azotite.wav.mp3"],[["nitrite","",[],[],[]]],{"plural":"azotites"},[],["À l'acide azoteux AzO₂H correspondent les azotites utilisés (sels de sodium, de potassium) dans l'industrie des matières colorantes."]],[44275,"azotobacter","noun",0,"","m","",[["Azotobacter bacterium","",[],[],[]]],{"plural":"azotobacters"},[],""],[44276,"azoturie","noun",0,"/a.zɔ.ty.ʁi/","f",[33804,"LL-Q150_%28fra%29-Poslovitch-azoturie.wav.mp3"],[["azoturia","",[],[],[]]],{"plural":"azoturies"},[],""],[44277,"azoté","adjective",0,"/a.zɔ.te/","",[33805,"LL-Q150_%28fra%29-LoquaxFR-azot%C3%A9.wav.mp3"],[["nitrogen; nitrogenous","",[],[],[]]],{"masculine":"azoté","feminine":"azotée","masculine_plural":"azotés","feminine_plural":"azotées"},[],["Diminuer la consommation globale de viande constituerait donc une première contribution à la réduction de la pollution azotée.","La production des témoins ayant bénéficié de la fumure azotée était la plus élevée, que ce soit sur sol acide ou sur vertisol.","Les prairies d'une grande partie de l'Europe ont ainsi perdu plus d'un quart de leurs espèces végétales après des décennies de dépôts azotés atmosphériques."]],[44278,"azotémie","noun",0,"/a.zɔ.te.mi/","f",[33806,"LL-Q150_%28fra%29-Poslovitch-azot%C3%A9mie.wav.mp3"],[["azotemia","",[],[],[]]],{"plural":"azotémies"},[],["L'excès est l'hyperazotémie.","L'azotémie se traduit seulement lorsqu'elle atteint un taux élevé, par des symptômes digestifs ou nerveux."]],[44279,"azotémique","adjective",0,"/a.zɔ.te.mik/","",[33807,"LL-Q150_%28fra%29-WikiLucas00-azot%C3%A9mique.wav.mp3"],[["azotemic","",[],[],[]]],{"masculine":"azotémique","masculine_plural":"azotémiques"},[],""],[44280,"azulène","noun",0,"/a.zy.lɛn/","m",[33808,"LL-Q150_%28fra%29-LoquaxFR-azul%C3%A8ne.wav.mp3"],[["azulene","",[],[],[]]],{"plural":"azulènes"},[],""],[44281,"azurage","noun",0,"/a.zy.ʁaʒ/","m",[33809,"LL-Q150_%28fra%29-WikiLucas00-azurage.wav.mp3"],[["blueing","",[],[],[]]],{"plural":"azurages"},[],""],[44282,"azurer","verb",0,"/a.zy.ʁe/","",[33810,"LL-Q150_%28fra%29-Lepticed7-azurer.wav.mp3"],[["to blue (brighten laundry)","",[],[],[]]],{"infinitive":"azurer","auxiliary":"avoir","present_participle":"azurant","past_participle":"azuré","present":["azure","azures","azure","azurons","azurez","azurent"],"imperfect":["azurais","azurais","azurait","azurions","azuriez","azuraient"],"future":["azurerai","azureras","azurera","azurerons","azurerez","azureront"],"conditional":["azurerais","azurerais","azurerait","azurerions","azureriez","azureraient"],"subjunctive":["azure","azures","azure","azurions","azuriez","azurent"]},[],["Au loin, la mer s'azurait et scintillait.","Généralement on azure son linge sans le savoir pour le rendre plus blanc.","Le regard, à travers ce rideau de verdure, / Ne voit rien que le ciel et l'onde qu'il azure. (Lamartine)."]],[44283,"azurite","noun",0,"/a.zy.ʁit/","f",[33811,"LL-Q150_%28fra%29-WikiLucas00-azurite.wav.mp3"],[["azurite","",[],[],[]]],{"plural":"azurites"},[],["L'azurite peut être utilisée, comme la malachite comme pigment.","Dans la collection Guyonneau, sont remarquables les azurites et les tourmalines, dont une énorme en forme de cristal."]],[44284,"azuréen","adjective",0,"/a.zy.ʁe.ɛ̃/","",[33812,"LL-Q150_%28fra%29-Lyoko%C3%AF-azur%C3%A9en.wav.mp3"],[["of the Côte d'Azur","",[],[],[]]],{"masculine":"azuréen","feminine":"azuréenne","masculine_plural":"azuréens","feminine_plural":"azuréennes"},[],["Quoi? dit-il en ouvrant tout grand ses yeux azuréens.","L'autre motivation, c'est mon amour des décors encore sauvages du littoral azuréen, dont je suis natif.","L'orage tombé sur le littoral azuréen samedi et dimanche a fait trembler plus que les murs dans les Alpes-Maritimes."]],[44285,"azène","noun",0,"","m","",[["azene","",[],[],[]]],{"plural":"azènes"},[],""],[44286,"azète","noun",0,"","m","",[["azete","",[],[],[]]],{"plural":"azètes"},[],""],[44287,"azédarach","noun",0,"/a.ze.da.ʁak/","m",[33813,"LL-Q150_%28fra%29-Lyoko%C3%AF-az%C3%A9darach.wav.mp3"],[["azedarach, bead tree, chinaberry (Melia azedarach)","",[],[],[]]],{"plural":"azédarachs"},[],["On voyait autour de son cou un collier de grains d'adrézarach avec un petit sachet de soie, orné de verroterie verte."]],[44288,"azéotrope","noun",0,"/a.ze.ɔ.tʁɔp/","m",[33814,"LL-Q150_%28fra%29-Lyoko%C3%AF-az%C3%A9otrope.wav.mp3"],[["azeotrope","",[],[],[]]],{"plural":"azéotropes"},[],["Envisageons maintenant le cas où le diagramme de phases isobares contient un azéotrope de vaporisation."]],[44289,"azéotropique","adjective",0,"/a.ze.ɔ.tʁɔ.pik/","","",[["azeotropic","",[],[],[]]],{"masculine":"azéotropique","masculine_plural":"azéotropi
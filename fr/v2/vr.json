ous dites."]],[16416,"vrombir","verb",2,"/vʁɔ̃.biʁ/","",[13153,"Fr-vrombir.ogg.mp3"],[["to hum, whirr","",["intransitive"],[],[["L'essaim pourrait piquer : il n'est programmé que pour vrombir et vibrer, ce qui suffit, étrangement, à les décourager d'approcher des ouvertures.","The Stealthies",""]]]],{"infinitive":"vrombir","auxiliary":"avoir","present_participle":"vrombissant","past_participle":"vrombi","present":["vrombis","vrombis","vrombit","vrombissons","vrombissez","vrombissent"],"imperfect":["vrombissais","vrombissais","vrombissait","vrombissions","vrombissiez","vrombissaient"],"future":["vrombirai","vrombiras","vrombira","vrombirons","vrombirez","vrombiront"],"conditional":["vrombirais","vrombirais","vrombirait","vrombirions","vrombiriez","vrombiraient"],"subjunctive":["vrombisse","vrombisses","vrombisse","vrombissions","vrombissiez","vrombissent"]},[],""],[17704,"vrombissement","noun",2,"/vʁɔ̃.bis.mɑ̃/","m",[14191,"LL-Q150_%28fra%29-WikiLucas00-vrombissement.wav.mp3"],[["humming, whirring, whizzing","",[],[],[]]],{"plural":"vrombissements"},[],["C'est mythique, comme le vrombissement d'une Harley Davidson.","Ou, peut-être, crispées parce que par la porte du cabinet on entendait le vrombissement de la fraise dentaire. Il ressemblait au bruit d'une scie à bois."]],[33587,"vrillette","noun",1,"/vʁi.jɛt/","f",[27133,"LL-Q150_%28fra%29-Poslovitch-vrillette.wav.mp3"],[["a type of beetle that eats wood: specifically; one of a small number of species of beetle","",[],[],[]]],{"plural":"vrillettes"},[],["Les poutres et le plancher de cette église classée étaient infestés de larves de vrillettes. La municipalité a donc fait appel à une entreprise spécialisée."]],[35076,"vraquier","noun",1,"/vʁa.kje/","m",[28250,"LL-Q150_%28fra%29-Lyoko%C3%AF-vraquier.wav.mp3"],[["bulk carrier","",[],["transporteur de vrac"],[]]],{"plural":"vraquiers"},[],["Un vraquier plutôt petit dans sa catégorie, mais énorme à mes yeux.","L'imposant vraquier Federal Crimson est entré en collision a
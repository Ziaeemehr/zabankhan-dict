{"entries":[[17468,"ozone","noun",2,"/ɔ.zɔn/","m",[13998,"Fr-ozone.ogg.mp3"],[["ozone (O₃)","",[],[],[]]],{"plural":"ozones"},[],["Les molécules d'ozone sont instables et leur atomes se recombinent spontanément pour former du dioxygène.","L'azote réactif de l'atmosphère, sous forme d'oxydes d'azote (NOx), est l'une des principales sources d'ozone (O₃)."]],[70095,"ozaphane","noun",0,"","m","",[["a form of cellulose acetate used as film stock","",[],[],[]]],{"plural":"ozaphanes"},[],""],[70096,"ozocérite","noun",0,"/o.zɔ.se.ʁit/","f",[47078,"LL-Q150_%28fra%29-Bananax47-ozoc%C3%A9rite.wav.mp3"],[["ozocerite","",[],[],[]]],{"plural":"ozocérites"},[],""],[70097,"ozokérite","noun",0,"","f","",[["ozokerite","",[],[],[]]],{"plural":"ozokérites"},[],["Cependant, les amas d'ozokérite ne sont importants et exploitables que jusque 5 à 600 mètres de profondeur."]],[70098,"ozonateur","noun",0,"","m","",[["synonym of ozoniseur","",[],["ozoniseur"],[]]],{"plural":"ozonateurs"},[],["Cette propriété existait encore après une heure et demie quand l'ozonateur avait été actionné pendant dix minutes."]],[70099,"ozoner","verb",0,"/o.zɔ.ne/","",[47079,"LL-Q150_%28fra%29-Lyoko%C3%AF-ozoner.wav.mp3"],[["to ozonate","",[],["ozoniser"],[]]],{"infinitive":"ozoner","auxiliary":"avoir","present_participle":"ozonant","past_participle":"ozoné","present":["ozone","ozones","ozone","ozonons","ozonez","ozonent"],"imperfect":["ozonais","ozonais","ozonait","ozonions","ozoniez","ozonaient"],"future":["ozonerai","ozoneras","ozonera","ozonerons","ozonerez","ozoneront"],"conditional":["ozonerais","ozonerais","ozonerait","ozonerions","ozoneriez","ozoneraient"],"subjunctive":["ozone","ozones","ozone","ozonions","ozoniez","ozonent"]},[],""],[70100,"ozoneur","noun",0,"","m","",[["synonym of ozoniseur","",[],["ozoniseur"],[]]],{"plural":"ozoneurs"},[],["Lʼozoneur médical usuel consiste, en principe, en un petit tube à ozone en verre, que lʼon actionne par une bobine de Rhumkorff."]],[70101,"ozonide","noun",0,"","
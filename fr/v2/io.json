{"entries":[[11457,"iode","noun",2,"/jɔd/","m",[9494,"Fr-iode.ogg.mp3"],[["iodine (chemical element)","",["uncountable"],[],[]]],{},[],["L'iode se trouve dans le varech, dans les gisements de nitrate de soude du Chili."]],[21722,"ion","noun",1,"/jɔ̃/","m",[17472,"LL-Q150_%28fra%29-Pamputt-ion.wav.mp3"],[["ion","",[],[],[]]],{"plural":"ions"},[],""],[24941,"iota","noun",1,"/jɔ.ta/","m","",[["iota (Greek letter)","",[],[],[]],["jot, iota (negligible amount)","",[],[],[]]],{},["d'un iota"],["Il n'y a pas un seul iota à retrancher.","Je ne bougerai pas d'un iota sur cette offre.","Je copie textuellement et sans changer un iota."]],[25376,"ionique","adjective",1,"/jɔ.nik/","",[20519,"LL-Q150_%28fra%29-WikiLucas00-ionique.wav.mp3"],[["ionic","",[],[],[]],["Ionic","",[],[],[]]],{"masculine":"ionique","masculine_plural":"ioniques"},[],["Une colonne ionique.","Mètre ionique majeur : mètre compisé de deux longues suivies de deux brèves.","Mètre ionique mineur : mètre composé de deux brèves suivies de deux longues."]],[26710,"ionien","adjective",1,"/jɔ.njɛ̃/","",[21627,"LL-Q150_%28fra%29-Lepticed7-ionien.wav.mp3"],[["Ionian","",[],[],[]]],{"masculine":"ionien","feminine":"ionienne","masculine_plural":"ioniens","feminine_plural":"ioniennes"},[],["Il harcèle de questions Calliope van Langendonck, s'enquiert, auprès de cette beauté ionienne, de ce qui est « bon pour peau » ou « movais pour peau »…"]],[26711,"ionien","noun",1,"/jɔ.njɛ̃/","m",[21627,"LL-Q150_%28fra%29-Lepticed7-ionien.wav.mp3"],[["Ionic Greek","",["uncountable"],[],[]]],{},[],""],[27096,"ionisation","noun",1,"/jɔ.ni.za.sjɔ̃/","f",[21944,"LL-Q150_%28fra%29-WikiLucas00-ionisation.wav.mp3"],[["ionisation","",[],[],[]]],{"plural":"ionisations"},[],""],[27600,"iodé","adjective",1,"/jɔ.de/","","",[["iodized, iodinated","",[],[],[]]],{"masculine":"iodé","feminine":"iodée","masculine_plural":"iodés","feminine_plural":"iodées"},[],["La ficoïde, presque inconnue, est une variété de salade très rare, appréciée pour sa saveur iodée.","Elle entreprend une drôle de danse, qui tient du pogo et du swing en braillant à tue-tête: «L'air iodé, voilà ce qu'il me fallait.»"]],[28732,"ionosphère","noun",1,"/jɔ.nɔs.fɛʁ/","f",[23246,"LL-Q150_%28fra%29-Pamputt-ionosph%C3%A8re.wav.mp3"],[["ionosphere","",[],[],[]]],{"plural":"ionosphères"},[],""],[29473,"ionisé","adjective",1,"/jɔ.ni.ze/","","",[["ionized","",[],[],[]]],{"masculine":"ionisé","feminine":"ionisée","masculine_plural":"ionisés","feminine_plural":"ionisées"},[],""],[33378,"iodoforme","noun",1,"/jɔ.dɔ.fɔʁm/","m",[26968,"LL-Q150_%28fra%29-WikiLucas00-iodoforme.wav.mp3"],[["iodoform","",[],[],[]]],{"plural":"iodoformes"},[],["L'iodoforme est un antiseptique très employé.","On a injecté dans ces kystes de la glycérine iodoformée (Bobrow, 1895)","Le train qui glisse, la fumée à goût d'iodoforme, la portière, le plaid, le grand manteau, la moustache claire…"]],[34431,"iodler","verb",1,"/jɔd.le/","",[27771,"LL-Q150_%28fra%29-Lyoko%C3%AF-iodler.wav.mp3"],[["to yodel","",["intransitive"],[],[]]],{"infinitive":"iodler","auxiliary":"avoir","present_participle":"iodlant","past_participle":"iodlé","present":["iodle","iodles","iodle","iodlons","iodlez","iodlent"],"imperfect":["iodlais","iodlais","iodlait","iodlions","iodliez","iodlaient"],"future":["iodlerai","iodleras","iodlera","iodlerons","iodlerez","iodleront"],"conditional":["iodlerais","iodlerais","iodlerait","iodlerions","iodleriez","iodleraient"],"subjunctive":["iodle","iodles","iodle","iodlions","iodliez","iodlent"]},[],""],[35269,"iodure","noun",1,"/jɔ.dyʁ/","m",[28399,"LL-Q150_%28fra%29-Lyoko%C3%AF-iodure.wav.mp3"],[["iodide","",[],[],[]]],{"plural":"iodures"},[],["Un second procédé consiste à traiter le p-fluorophényl sulfinate de sodium par l'iodure d'éthyle dans l'éthanol.","Cette expérience prouve qu'une température élevée décompose également l'iodure tellurique dans cette combinaison.","C'est ainsi que le méthylarsonite de sodium réagit sous cette seconde forme, avec l'iodure de méthyle, pour donner le diméthylarsinate de sodium."]],[35270,"ionisant","adjective",1,"/jɔ.ni.zɑ̃/","","",[["ionizing","",[],[],[]]],{"masculine":"ionisant","feminine":"ionisante","masculine_plural":"ionisants","feminine_plural":"ionisantes"},[],["Le compteur Geiger a pour fonction de mesurer des rayonnements ionisants."]],[35481,"ioniser","verb",1,"/jɔ.ni.ze/","",[28577,"LL-Q150_%28fra%29-Lyoko%C3%AF-ioniser.wav.mp3"],[["to ionize","",[],[],[]]],{"infinitive":"ioniser","auxiliary":"avoir","present_participle":"ionisant","past_participle":"ionisé","present":["ionise","ionises","ionise","ionisons","ionisez","ionisent"],"imperfect":["ionisais","ionisais","ionisait","ionisions","ionisiez","ionisaient"],"future":["ioniserai","ioniseras","ionisera","ioniserons","ioniserez","ioniseront"],"conditional":["ioniserais","ioniserais","ioniserait","ioniserions","ioniseriez","ioniseraient"],"subjunctive":["ionise","ionises","ionise","ionisions","ionisiez","ionisent"]},[],["Pour rendre conducteur un espace qui ne l'est pas, on peut donc songer soit à ioniser un gaz, soit, si l'on peut dire, à \"électroniser un vide\"."]],[62200,"iochrome","noun",0,"/jɔ.kʁom/","m","",[["iochroma","",[],[],[]]],{"plural":"iochromes"},[],["Des oiseaux-mouches fécondent les fleurs d'iochromes."]],[62201,"iodate","noun",0,"","m","",[["iodate","",[],[],[]]],{"plural":"iodates"},[],["Le sous-chlorure, au contraire, se décompose en iode, iodate de potasse et chlorure de potassium."]],[62202,"ioder","verb",0,"/jɔ.de/","",[43421,"LL-Q150_%28fra%29-Lyoko%C3%AF-ioder.wav.mp3"],[["To iodate","",[],[],[]]],{"infinitive":"ioder","auxiliary":"avoir","present_participle":"iodant","past_participle":"iodé","present":["iode","iodes","iode","iodons","iodez","iodent"],"imperfect":["iodais","iodais","iodait","iodions","iodiez","iodaient"],"future":["ioderai","ioderas","iodera","ioderons","ioderez","ioderont"],"conditional":["ioderais","ioderais","ioderait","ioderions","ioderiez","ioderaient"],"subjunctive":["iode","iodes","iod